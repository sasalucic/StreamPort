# Copy to .env and replace placeholder paths with ABSOLUTE host paths.
# Keep .env private; it must never be committed.
MOVIES_PATH=/srv/media/movies
TV_PATH=/srv/media/tv
# Use the UID/GID with read access to your media and write access to ./data.
PUID=1000
PGID=1000
STREAMPORT_PORT=8097
# 0.0.0.0 permits LAN access; use 127.0.0.1 with a reverse proxy on the host.
BIND_ADDRESS=0.0.0.0
MAX_TRANSCODES=1
COOKIE_SECURE=false
# Optional; alternatively enter this in the administrator's Settings page.
OPENSUBTITLES_API_KEY=
